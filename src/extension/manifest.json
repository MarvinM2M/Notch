{
  "manifest_version": 3,
  "name": "WinNotch Web Connector",
  "version": "1.0.2",
  "description": "Forward web notifications from WhatsApp Web, Telegram Web, and Discord Web to WinNotch",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:3457/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://discord.com/*"
      ],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://discord.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
